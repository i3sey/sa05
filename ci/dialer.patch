+
+// newBeelineSessionID generates the XHTTP session ID used in the request URL.
+//
+// Stock Xray uses the full 36-char UUID string, which Beeline CDN rejects with
+// HTTP 403 before the request reaches the origin. Encoding 9 random bytes as
+// Base64URL (no padding) yields exactly 12 chars from the [A-Za-z0-9_-] set,
+// which Beeline passes through. The server treats the session ID as an opaque
+// string, so no server-side change is required.
+func newBeelineSessionID() string {
+	u := uuid.New()
+	return base64.RawURLEncoding.EncodeToString(u[:9])
+}
